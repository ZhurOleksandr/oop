# ============================================================
# MediPredictor v2.0 — Конфігурація
# Скопіюйте: copy .env.example .env  (Windows)
#        або: cp .env.example .env   (Linux/Mac)
# ============================================================

# ── База даних ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=medipredictor

# ── Або повний URL (розкоментуйте якщо потрібно) ─────────────
# DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/medipredictor

# ── Безпека ───────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────
# "*" = дозволити всі origins (зручно для розробки)
# Для продакшн вкажіть конкретні адреси:
# FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5500
FRONTEND_ORIGINS=*

# ── Сервер ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
